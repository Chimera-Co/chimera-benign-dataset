    "command_lines": [
      "/bin/sh /home/arjun/Downloads/log-rotate-archive.sh",
      "mkdir -p /tmp/logarchive",
      "cp /var/log/Xorg.0.log /tmp/logarchive/",
      "cp /var/log/alternatives.log /tmp/logarchive/",
      "cp /var/log/dpkg.log /tmp/logarchive/",
      "cp /var/log/fontconfig.log /tmp/logarchive/",
      "journalctl --no-pager -n 500",
      "date +%Y%m%d",
      "tar czf /tmp/logs-20261023.tgz -C /tmp logarchive",
      "/bin/sh -c gzip",
      "gzip",
      "sha256sum /tmp/logs-20261023.tgz",
      "curl -fsS -m 15 -T /tmp/logs-20261023.tgz http://logs.corp.example/upload/",
      "find /tmp -name logs-*.tgz -mtime +7 -delete"
    ],
